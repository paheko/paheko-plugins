<?xml version='1.0' encoding='UTF-8'?>
<!-- ORDER OF ELEMENTS CANNOT BE CHANGED! -->
<!-- https://e-invoice.be/en16931-mapper -->
<rsm:CrossIndustryInvoice
	xmlns:qdt="urn:un:unece:uncefact:data:standard:QualifiedDataType:100"
	xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100"
	xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100"
	xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">
	<rsm:ExchangedDocumentContext>
		<ram:BusinessProcessSpecifiedDocumentContextParameter>
			<!-- BT-23 Business process type (Identifiant de type de processus métier) : S1 -->
			<ram:ID>{$invoice.process_control.business_process_type}</ram:ID>
		</ram:BusinessProcessSpecifiedDocumentContextParameter>
		<ram:GuidelineSpecifiedDocumentContextParameter>
			<!-- BT-24 Specification identifier -->
			<ram:ID>{$invoice.process_control.specification_identifier}</ram:ID>
		</ram:GuidelineSpecifiedDocumentContextParameter>
	</rsm:ExchangedDocumentContext>
	<rsm:ExchangedDocument>
		<!-- BT-1 Invoice number -->
		<ram:ID>{$invoice.number}</ram:ID>
		<!-- BT-3 Invoice type code -->
		<ram:TypeCode>{$invoice.type_code}</ram:TypeCode>
		<ram:IssueDateTime>
			<!-- BT-2 Invoice issue date -->
			<!-- format 102 = YYYYMMDD -->
			<udt:DateTimeString format="102">{$invoice.issue_date|date_format:'%Y%m%d'}</udt:DateTimeString>
		</ram:IssueDateTime>
		{foreach from=$invoice.notes item="note"}
			<ram:IncludedNote>
				<!-- BT-22 Invoice note -->
				<ram:Content>{$note.note}</ram:Content>
				{if $note.subject_code}
					<!-- BT-21 Invoice note subject code -->
					<ram:SubjectCode>{$note.subject_code}</ram:SubjectCode>
				{/if}
			</ram:IncludedNote>
		{/foreach}
	</rsm:ExchangedDocument>
	<rsm:SupplyChainTradeTransaction>
		<!-- Lignes de la facture -->
		{foreach from=$invoice.lines item="line"}
		<ram:IncludedSupplyChainTradeLineItem>
			<ram:AssociatedDocumentLineDocument>
				<ram:LineID>{$line.identifier}</ram:LineID><!-- Numéro unique de la ligne -->
				<!-- Unused currently
				<ram:IncludedNote>
					<ram:Content>{$line.notes}</ram:Content>
				</ram:IncludedNote>
				-->
			</ram:AssociatedDocumentLineDocument>
			<ram:SpecifiedTradeProduct>
				<ram:SellerAssignedID>{$line.item_information.seller_identifier}</ram:SellerAssignedID><!-- Ref vendeur -->
				<ram:Name>{$line.item_information.name}</ram:Name>
				<ram:Description>{$line.item_information.description}</ram:Description>
			</ram:SpecifiedTradeProduct>
			<ram:SpecifiedLineTradeAgreement>
				<ram:BuyerOrderReferencedDocument>
					<ram:LineID>{$line.identifier}</ram:LineID>
				</ram:BuyerOrderReferencedDocument>
				<ram:NetPriceProductTradePrice>
					<ram:ChargeAmount>{$line.price_details.item_net_price}</ram:ChargeAmount><!-- Prix unitaire net (hors taxe) -->
				</ram:NetPriceProductTradePrice>
			</ram:SpecifiedLineTradeAgreement>
			<ram:SpecifiedLineTradeDelivery>
				<ram:BilledQuantity unitCode="{$line.invoiced_quantity_code}">{$line.invoiced_quantity}</ram:BilledQuantity>
				<!-- Quantité, C62 = unité, penser à indiquer l'unité dans la description de la ligne -->
			</ram:SpecifiedLineTradeDelivery>
			<ram:SpecifiedLineTradeSettlement>
				<ram:ApplicableTradeTax>
					<ram:TypeCode>VAT</ram:TypeCode>
					<ram:CategoryCode>{$line.vat_information.invoiced_item_vat_category_code}</ram:CategoryCode>
					<ram:RateApplicablePercent>{$line.vat_information.invoiced_item_vat_rate}</ram:RateApplicablePercent>
				</ram:ApplicableTradeTax>
				<ram:SpecifiedTradeSettlementLineMonetarySummation>
					<ram:LineTotalAmount>{$line.net_amount}</ram:LineTotalAmount> <!-- Montant net total de la ligne (HT) -->
				</ram:SpecifiedTradeSettlementLineMonetarySummation>
			</ram:SpecifiedLineTradeSettlement>
		</ram:IncludedSupplyChainTradeLineItem>
		{/foreach}
		<ram:ApplicableHeaderTradeAgreement>
			{if $invoice.buyer_reference}
				<!-- BT-10 Buyer reference -->
				<!-- Référence acheteur. "Service exécutant" Code service pour Chorus Pro. Obligatoire pour les entités publiques marquées « Service obligatoire » dans Chorus Pro. -->
				<ram:BuyerReference>{$invoice.buyer_reference}</ram:BuyerReference>
			{/if}
			<!-- BG-4 - Seller -->
			<ram:SellerTradeParty>
				{foreach from=$invoice.seller.identifiers.items item="id"}
					<!-- BT-29 seller identifier (SIRET in France) -->
					<ram:GlobalID schemeID="{$id.scheme}">{$id.value}</ram:GlobalID>
				{/foreach}
				<!-- BT-27 seller name -->
				<ram:Name>{$invoice.seller.name}</ram:Name>
				{if $invoice.seller.legal_registration_identifier.value}
					<ram:SpecifiedLegalOrganization>
						<!-- BT-30 Seller legal registration identifier -->
						<ram:ID schemeID="{$invoice.seller.legal_registration_identifier.scheme}">{$invoice.seller.legal_registration_identifier.value}</ram:ID>
					</ram:SpecifiedLegalOrganization>
				{/if}
				<ram:DefinedTradeContact>
					{if $invoice.seller.contact.phone_number}
						<ram:TelephoneUniversalCommunication>
							<!-- BT-42 Seller contact telephone number -->
							<ram:CompleteNumber>{$invoice.seller.contact.phone_number}</ram:CompleteNumber>
						</ram:TelephoneUniversalCommunication>
					{/if}
					<ram:EmailURIUniversalCommunication>
						<!-- BT-43 Seller contact email address -->
						<ram:URIID>{$invoice.seller.contact.email_address}</ram:URIID>
					</ram:EmailURIUniversalCommunication>
				</ram:DefinedTradeContact>
				<!-- BG-5 - Seller postal address -->
				<ram:PostalTradeAddress>
					<!-- BT-39 Seller post code -->
					<ram:PostcodeCode>{$invoice.seller.postal_address.post_code}</ram:PostcodeCode>
					<!-- BT-35 Seller address line 1 -->
					<ram:LineOne>{$invoice.seller.postal_address.address_line1}</ram:LineOne>
					<!-- BT-36 Seller address line 2 -->
					<ram:LineTwo>{$invoice.seller.postal_address.address_line2}</ram:LineTwo>
					<!-- BT-37 Seller address line 3 -->
					<ram:LineThree>{$invoice.seller.postal_address.address_line3}</ram:LineThree>
					<!-- BT-38 Seller city -->
					<ram:CityName>{$invoice.seller.postal_address.city}</ram:CityName>
					<!-- BT-41 Seller country code (mandatory) -->
					<ram:CountryID>{$invoice.seller.postal_address.country_code}</ram:CountryID>
				</ram:PostalTradeAddress>
				{if $invoice.seller.electronic_address.value}
					<ram:URIUniversalCommunication>
						<!-- BT-34 (mandatory) Seller electronic address (eg. 0225 in France) -->
						<ram:URIID schemeID="{$invoice.seller.electronic_address.scheme}">{$invoice.seller.electronic_address.value}</ram:URIID>
					</ram:URIUniversalCommunication>
				{elseif $invoice.seller.contact.email_address}
					<ram:URIUniversalCommunication>
						<ram:URIID schemeID="EM">{$invoice.seller.contact.email_address}</ram:URIID><!-- Adresse e-mail du vendeur -->
					</ram:URIUniversalCommunication>
				{/if}
				{if $invoice.seller.vat_identifier}
					<ram:SpecifiedTaxRegistration>
						<!-- BT-31 Seller VAT identifier (Numéro TVA) -->
						<ram:ID schemeID="VA">{$invoice.seller.vat_identifier}</ram:ID>
					</ram:SpecifiedTaxRegistration>
				{elseif $invoice.seller.postal_address.country_code === 'FR'}
					<ram:SpecifiedTaxRegistration>
						<!--
						BT-32 Seller tax registration identifier
						Rule: BR-FR-CO-16 (see https://github.com/OCA/l10n-france/pull/759/changes)
						"Si le Vendeur n'a pas de n° de TVA, il doit répéter son n° de SIREN en BT-32"
						FC code is from https://unece.org/fileadmin/DAM/trade/untdid/d16b/tred/tred1153.htm
						-->
						<ram:ID schemeID="FC">{$invoice.seller.legal_registration_identifier.value}</ram:ID>
					</ram:SpecifiedTaxRegistration>
				{/if}
			</ram:SellerTradeParty>
			<!-- BG-7 - Buyer -->
			<ram:BuyerTradeParty>
				{foreach from=$invoice.seller.identifiers.items item="id"}
					<!-- BT-46 buyer identifier -->
					<ram:GlobalID schemeID="{$id.scheme}">{$id.value}</ram:GlobalID>
				{/foreach}
				<!-- BT-44 Buyer name -->
				<ram:Name>{$invoice.buyer.name}</ram:Name>
				{if $invoice.buyer.legal_registration_identifier.value}
					<ram:SpecifiedLegalOrganization>
						<!-- BT-47 Buyer legal registration identifier -->
						<!-- SchemeIDs: https://docs.peppol.eu/poacc/billing/3.0/codelist/ICD/ -->
						<ram:ID schemeID="{$invoice.buyer.legal_registration_identifier.scheme}">{$invoice.buyer.legal_registration_identifier.value}</ram:ID>
					</ram:SpecifiedLegalOrganization>
				{/if}
				{if $invoice.buyer.contact.phone_number || $invoice.buyer.contact.email_address}
					<ram:DefinedTradeContact>
						{if $invoice.buyer.contact.phone_number}
						<ram:TelephoneUniversalCommunication>
							<ram:CompleteNumber>{$invoice.buyer.contact.phone_number}</ram:CompleteNumber>
						</ram:TelephoneUniversalCommunication>
						{/if}
						{if $invoice.buyer.contact.email_address}
						<ram:EmailURIUniversalCommunication>
							<ram:URIID>{$invoice.buyer.contact.email_address}</ram:URIID>
						</ram:EmailURIUniversalCommunication>
						{/if}
					</ram:DefinedTradeContact>
				{/if}
				<!-- BG-8 - Buyer postal address -->
				<ram:PostalTradeAddress>
					<!-- BT-54 Buyer post code -->
					<ram:PostcodeCode>{$invoice.buyer.postal_address.post_code}</ram:PostcodeCode>
					<!-- BT-50 Buyer address line 1 -->
					<ram:LineOne>{$invoice.buyer.postal_address.address_line1}</ram:LineOne>
					<!-- BT-51 Buyer address line 2 -->
					<ram:LineTwo>{$invoice.buyer.postal_address.address_line2}</ram:LineTwo>
					<!-- BT-52 Buyer address line 3 -->
					<ram:LineThree>{$invoice.buyer.postal_address.address_line3}</ram:LineThree>
					<!-- BT-53 Buyer city -->
					<ram:CityName>{$invoice.buyer.postal_address.city}</ram:CityName>
					<!-- BT-56 Buyer country code -->
					<ram:CountryID>{$invoice.buyer.postal_address.country_code}</ram:CountryID>
				</ram:PostalTradeAddress>
				{if $invoice.buyer.electronic_address.value}
					<ram:URIUniversalCommunication>
						<!-- BT-49 Buyer electronic address (eg. 0225 in France) -->
						<ram:URIID schemeID="{$invoice.buyer.electronic_address.scheme}">{$invoice.buyer.electronic_address.value}</ram:URIID>
					</ram:URIUniversalCommunication>
				{elseif $invoice.buyer.contact.email_address}
					<ram:URIUniversalCommunication>
						<ram:URIID schemeID="EM">{$invoice.buyer.contact.email_address}</ram:URIID><!-- Adresse e-mail du client -->
					</ram:URIUniversalCommunication>
				{/if}
				{if $invoice.buyer.vat_identifier}
					<ram:SpecifiedTaxRegistration>
						<!-- BT-48 Buyer VAT identifier -->
						<ram:ID schemeID="VA">{$invoice.buyer.vat_identifier}</ram:ID>
					</ram:SpecifiedTaxRegistration>
				{/if}
			</ram:BuyerTradeParty>

			{if $invoice.purchase_order_reference}
				<ram:BuyerOrderReferencedDocument>
					<!-- BT-13 Purchase order reference -->
					<!-- Numéro commande acheteur. "Numéro d'engagement juridique" Texte libre. Pour Chorus Pro, indiquer ici le numéro d'engagement. Obligatoire pour les entités publiques marquées « Engagement obligatoire » dans Chorus Pro. -->
					<ram:IssuerAssignedID>{$invoice.purchase_order_reference}</ram:IssuerAssignedID>
				</ram:BuyerOrderReferencedDocument>
			{/if}
		</ram:ApplicableHeaderTradeAgreement>
		<ram:ApplicableHeaderTradeDelivery>
			<!-- This is useless, but required by validator -->
			<ram:ShipToTradeParty>
				<!-- BT-70 Deliver to party name -->
				<ram:Name>{$invoice.seller.name}</ram:Name>
			</ram:ShipToTradeParty>
		</ram:ApplicableHeaderTradeDelivery>
		<ram:ApplicableHeaderTradeSettlement>
			<!-- BT-5 Invoice currency code -->
			<ram:InvoiceCurrencyCode>{$invoice.currency_code}</ram:InvoiceCurrencyCode>
			{if $invoice.payment_instructions}
				<ram:SpecifiedTradeSettlementPaymentMeans>
					<!-- BT-81 Payment means type code -->
					<ram:TypeCode>{$invoice.payment_instructions.payment_means_type_code}</ram:TypeCode>
					<!-- BT-82 Payment means text -->
					<ram:Information>{$invoice.payment_instructions.payment_means_text}</ram:Information>
					<ram:PayeePartyCreditorFinancialAccount>
						<!-- BT-84 Payment account identifier (IBAN) -->
						<ram:IBANID>{$invoice.payment_instructions.credit_transfers.payment_account_identifier.value}</ram:IBANID>
					</ram:PayeePartyCreditorFinancialAccount>
					<ram:PayeeSpecifiedCreditorFinancialInstitution>
						<!-- BT-86 Payment service provider identifier (BIC) -->
						<ram:BICID>{$invoice.payment_instructions.credit_transfers.payment_service_provider_identifier}</ram:BICID>
					</ram:PayeeSpecifiedCreditorFinancialInstitution>
				</ram:SpecifiedTradeSettlementPaymentMeans>
			{/if}
			<!-- BG-23 - VAT breakdown -->
			<!-- Blocs de TVA, un bloc par taux de TVA -->
			{foreach from=$invoice.vat_break_down item="vat"}
			<ram:ApplicableTradeTax>
				<!-- BT-117 VAT category tax amount -->
				<ram:CalculatedAmount>{$vat.vat_category_tax_amount}</ram:CalculatedAmount>
				<ram:TypeCode>VAT</ram:TypeCode>
				{if $vat.vat_category_code === 'E'}
					<!-- BT-120 VAT exemption reason text -->
					<!-- Si exempté de TVA, alors il faut indiquer une raison de l'exemption de TVA -->
					<!-- Codes : https://docs.peppol.eu/poacc/billing/3.0/codelist/vatex/ -->
					<ram:ExemptionReason>{$vat.vat_exemption_reason}</ram:ExemptionReason>
				{/if}
				<!-- BT-116 VAT category taxable amount -->
				<ram:BasisAmount>{$vat.vat_category_taxable_amount}</ram:BasisAmount>
				<!-- BT-118 VAT category code -->
				<ram:CategoryCode>{$vat.vat_category_code}</ram:CategoryCode>
				{if $vat.vat_category_code === 'E'}
					<!-- BT-121 VAT exemption reason code -->
					<!-- This needs to be here and cannot be with ExemptionReason as the order of elements is important (!) -->
					<ram:ExemptionReasonCode>{$vat.vat_exemption_reason_code}</ram:ExemptionReasonCode>
				{/if}
				<!-- BT-8 Value added tax point date code -->
				<!-- Ce code ne peut être présent si la date d'exigibilité est fournie directement
				dans l'élément Date d'exigibilité de la taxe sur la valeur ajoutée" (BT-7).
				Ce code doit être choisi parmi les valeurs suivantes issues de l'UNTDID 2475 (au lieu de UNTDID 2005 [6]):
				5 : Date de la facture (TVA sur DEBITS)
				29 : Date de livraison (TVA sur DEBITS)
				72 : Date de paiement (TVA sur ENCAISSEMENTS) -->
				<ram:DueDateTypeCode>72</ram:DueDateTypeCode>
				<!-- BT-119 VAT category rate -->
				<ram:RateApplicablePercent>{$vat.vat_category_rate}</ram:RateApplicablePercent>
			</ram:ApplicableTradeTax>
			{/foreach}
			<ram:SpecifiedTradePaymentTerms>
				<ram:DueDateDateTime>
					<!-- BT-9 Payment due date -->
					<udt:DateTimeString format="102">{$invoice.payment_due_date|date_format:'%Y%m%d'}</udt:DateTimeString>
				</ram:DueDateDateTime>
			</ram:SpecifiedTradePaymentTerms>
			<!-- BG-22 - Document totals -->
			<ram:SpecifiedTradeSettlementHeaderMonetarySummation>
				<!-- BT-106 Sum of Invoice line net amount -->
				<ram:LineTotalAmount>{$invoice.totals.sum_invoice_lines_amount}</ram:LineTotalAmount>
				<!-- BT-109 Invoice total amount without VAT (total HT) -->
				<ram:TaxBasisTotalAmount>{$invoice.totals.total_without_vat}</ram:TaxBasisTotalAmount>
				<!-- BT-110 Invoice total VAT amount (TVA) -->
				<ram:TaxTotalAmount currencyID="{$invoice.currency_code}">{$invoice.totals.total_vat_amount}</ram:TaxTotalAmount>
				<!-- BT-114 Rounding amount -->
				<ram:RoundingAmount>0.00</ram:RoundingAmount>
				<!-- BT-112 Invoice total amount with VAT (total TTC) -->
				<ram:GrandTotalAmount>{$invoice.totals.total_with_vat}</ram:GrandTotalAmount>
				<!-- BT-113 Paid amount -->
				<ram:TotalPrepaidAmount>0.00</ram:TotalPrepaidAmount>
				<!-- BT-115 Amount due for payment (reste à payer) -->
				<ram:DuePayableAmount>{$invoice.totals.amount_due_for_payment}</ram:DuePayableAmount>
			</ram:SpecifiedTradeSettlementHeaderMonetarySummation>
			{if $invoice.preceding_invoice_reference}
			<ram:InvoiceReferencedDocument> <!-- BG-3, 0..n, RÉFÉRENCE À UNE FACTURE ANTÉRIEURE -->
				<ram:IssuerAssignedID>{$invoice.preceding_invoice_reference.reference}</ram:IssuerAssignedID>
				<ram:FormattedIssueDateTime>
					<qdt:DateTimeString format="102">{$invoice.preceding_invoice_reference.issue_date|date_format:'%Y%m%d'}</qdt:DateTimeString>
				</ram:FormattedIssueDateTime>
			</ram:InvoiceReferencedDocument>
			{/if}
		</ram:ApplicableHeaderTradeSettlement>
	</rsm:SupplyChainTradeTransaction>
</rsm:CrossIndustryInvoice>
